# --- CiberTeatro: variables de entorno ---
# Copia este archivo a .env y completa los valores reales.

# Base de datos PostgreSQL
DATABASE_URL=postgresql+psycopg://ciberteatro:ciberteatro@db:5432/ciberteatro

# API de Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-5

# Seguridad de la app
SECRET_KEY=cambia-esto-en-produccion-por-un-valor-aleatorio-largo
ACCESS_TOKEN_EXPIRE_MINUTES=120

# CORS para el frontend Next.js
FRONTEND_ORIGINS=http://localhost:3000

# Política agregada: mínimo de respuestas para mostrar métricas a empleadores
MIN_AGGREGATE_N=10

# Máximo permitido de dificultad. Codificado como techo absoluto.
MAX_DIFFICULTY=3

# Entorno (development | staging | production)
ENVIRONMENT=development
