# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
# Default model: claude-sonnet-4-6 (latest sonnet in Claude 4.x family)
# Can be overridden per environment.
CIBERSPAR_MODEL=claude-sonnet-4-6
CIBERSPAR_MODEL_FAST=claude-haiku-4-5-20251001

# --- Redis (session-only, ephemeral) ---
REDIS_URL=redis://localhost:6379/0

# --- Postgres (catalogs + aggregated metrics ONLY, never session data) ---
POSTGRES_DSN=postgresql+asyncpg://ciberspar:ciberspar@localhost:5432/ciberspar

# --- App ---
CIBERSPAR_ENV=dev
CIBERSPAR_CORS_ORIGINS=http://localhost:3000

# --- Non-negotiable safety constants (overridable for tests only) ---
# 30-minute session ceiling. Codified, not declarative.
SESSION_TTL_SECONDS=1800
# Aggregation threshold: no metric is shown unless n >= this value.
AGGREGATION_MIN_N=10
